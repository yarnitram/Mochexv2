datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  TRADER
  ADMIN
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  username     String        @unique @db.VarChar(50)
  email        String        @unique @db.VarChar(255)
  passwordHash String        @map("password_hash")
  role         Role          @default(TRADER)
  createdAt    DateTime      @default(now()) @map("created_at")

  layouts      ChartLayout[]
  indicators   Indicator[]
  watchlists   Watchlist[]

  @@map("users")
}

model ChartLayout {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  name       String   @db.VarChar(100)
  symbol     String   @default("BTCUSDT") @db.VarChar(30)
  resolution String   @default("15") @db.VarChar(10)
  content    Json     // Serialized TradingView layout JSON (drawings, scales, settings)
  isDefault  Boolean  @default(false) @map("is_default")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("chart_layouts")
}

model Indicator {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  scriptCode   String   @map("script_code") @db.Text
  inputsSchema Json     @map("inputs_schema")
  isGlobal     Boolean  @default(false) @map("is_global")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isGlobal])
  @@map("indicators")
}

model Watchlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @default("Main Watchlist") @db.VarChar(50)
  symbols   Json     @default("[\"BTCUSDT\", \"ETHUSDT\", \"SOLUSDT\"]")
  isDefault Boolean  @default(true) @map("is_default")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("watchlists")
}
